# ═══════════════════════════════════════════════════════════════════
# Variables de entorno — 29 de Mayo
# ═══════════════════════════════════════════════════════════════════
#
# IMPORTANTE: copia este archivo a `.env` (sin .example) y rellena las
# claves reales. .env está en .gitignore y NUNCA se sube a GitHub.
#
# En producción (Netlify), añade estas mismas variables en:
#   Dashboard → Site settings → Environment variables
#
# ───────────────────────────────────────────────────────────────────


# ── Resend — newsletter y emails transaccionales ───────────────────
# Consigue tu API key en: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# ID del audience en Resend (Audiences → crear uno → copiar ID)
RESEND_AUDIENCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx


# ── Anthropic Claude — para el widget "Pregunta al libro" ──────────
# Consigue tu API key en: https://console.anthropic.com/settings/keys
# Mientras no la añadas, el chat funciona con respuestas pre-escritas.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxx
