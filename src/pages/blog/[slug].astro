---
import Base  from '../../layouts/Base.astro';
import Nav   from '../../components/Nav.astro';
import { posts } from '../../data/posts';

export function getStaticPaths() {
  return posts.map((post) => ({
    params: { slug: post.slug },
    props:  { post },
  }));
}

const { post } = Astro.props;

// Next post (for navigation)
const idx  = posts.findIndex(p => p.slug === post.slug);
const next = posts[idx + 1] ?? posts[0];

// Calcular tiempo de lectura — promedio 220 palabras/min en castellano
const wordCount   = post.contenido.replace(/<[^>]+>/g, '').split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.round(wordCount / 220));

// URL pública para sharing
const postUrl = `https://29demayo.es/blog/${post.slug}`;
const shareTitle = encodeURIComponent(post.titulo);
const shareUrl   = encodeURIComponent(postUrl);
const shareText  = encodeURIComponent(`${post.titulo} — por Elías Alcedo Espinosa`);
---

<Base
  title={`${post.titulo} | Elías Alcedo Espinosa`}
  description={post.extracto}
>
  <Nav />

  <!-- Reading progress bar (fixed top) -->
  <div id="post-progress" class="post-progress" aria-hidden="true"></div>

  <main class="min-h-screen bg-[var(--color-bg)] pt-24 pb-32">

    <!-- Hero del post -->
    <div class="relative py-20 px-6 overflow-hidden" style={`background: ${post.temaColor.replace('0.', '0.0')};`}>
      <div class="absolute inset-0 pointer-events-none" aria-hidden="true"
           style={`background: radial-gradient(ellipse at 30% 50%, ${post.temaColor} 0%, transparent 70%);`}></div>
      <div class="absolute inset-0 pointer-events-none"
           style="background: linear-gradient(to bottom, transparent 60%, var(--color-bg) 100%);"
           aria-hidden="true"></div>

      <div class="relative max-w-3xl mx-auto">
        <a href="/blog" class="font-mono text-[0.62rem] tracking-[0.35em] text-[var(--color-muted)] hover:text-[var(--color-amber)] uppercase transition-colors duration-300 inline-flex items-center min-h-[44px] mb-6">
          ← Blog
        </a>

        <div class="flex items-center gap-4 mb-6 flex-wrap">
          <time datetime={post.fechaISO}
                class="font-mono text-[0.6rem] tracking-[0.35em] uppercase text-[var(--color-muted)]">
            {post.fecha}
          </time>
          <span class="w-1 h-1 rounded-full bg-[var(--color-border)]"></span>
          <span class="font-mono text-[0.6rem] tracking-[0.35em] uppercase"
                style="color: var(--color-amber);">
            Elías Alcedo Espinosa
          </span>
          <span class="w-1 h-1 rounded-full bg-[var(--color-border)]"></span>
          <span class="font-mono text-[0.6rem] tracking-[0.35em] uppercase text-[var(--color-muted)]">
            ⏱ {readingTime} min lectura
          </span>
        </div>

        <h1 class="font-serif text-[clamp(2rem,6vw,4rem)] text-[var(--color-text)] leading-[1.05]"
            style="letter-spacing: -0.02em;">
          {post.titulo}
        </h1>

        <div class="w-12 h-px mt-8" style="background: rgba(163,21,21,0.5);"></div>
      </div>
    </div>

    <!-- Share sidebar flotante (desktop) -->
    <aside class="share-sidebar" aria-label="Compartir artículo">
      <span class="share-label">Compartir</span>
      <a href={`https://twitter.com/intent/tweet?text=${shareText}&url=${shareUrl}`}
         target="_blank" rel="noopener noreferrer"
         class="share-link"
         data-cursor="X (Twitter)"
         aria-label="Compartir en X / Twitter">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
      </a>
      <a href={`https://wa.me/?text=${shareText}%20${shareUrl}`}
         target="_blank" rel="noopener noreferrer"
         class="share-link"
         data-cursor="WhatsApp"
         aria-label="Compartir en WhatsApp">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.71.306 1.263.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
      </a>
      <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`}
         target="_blank" rel="noopener noreferrer"
         class="share-link"
         data-cursor="LinkedIn"
         aria-label="Compartir en LinkedIn">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.063 2.063 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
      </a>
      <button id="copy-link" class="share-link" data-cursor="Copiar link" aria-label="Copiar link">
        <svg id="copy-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71"/></svg>
        <svg id="copy-ok-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" style="display:none;"><polyline points="20 6 9 17 4 12"/></svg>
      </button>
    </aside>

    <!-- Contenido -->
    <div class="max-w-3xl mx-auto px-6 mt-4">
      <div
        class="post-content font-sans text-[var(--color-muted)] leading-[1.85] text-[1.05rem]"
        set:html={post.contenido}
      />

      <!-- Firma -->
      <div class="mt-16 pt-10 border-t border-[var(--color-border)] flex items-center gap-5">
        <img
          src="/images/autor.jpg"
          alt="Elías Alcedo Espinosa"
          width="52"
          height="52"
          class="rounded-full object-cover grayscale"
          style="width:52px; height:52px; filter:grayscale(100%);"
        />
        <div>
          <p class="font-serif text-[var(--color-text)] text-[0.95rem]">Elías Alcedo Espinosa</p>
          <p class="font-mono text-[0.62rem] tracking-[0.2em] text-[var(--color-muted)] uppercase mt-0.5">
            Cádiz · 2025 · Autor de 29 de Mayo
          </p>
        </div>
      </div>

      <!-- CTA Amazon -->
      <div class="mt-12 p-8 border border-[rgba(163,21,21,0.15)] rounded"
           style="background: rgba(163,21,21,0.04);">
        <p class="font-italic italic text-[var(--color-text)] leading-relaxed mb-6"
           style="font-family:'Lora',Georgia,serif; font-size:clamp(1rem,2vw,1.15rem);">
          Si estas palabras te han resonado, el libro cuenta mucho más. El año entero. Mes a mes.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="https://amzn.to/3RlmkaH" target="_blank" rel="noopener noreferrer"
             class="btn-amber btn-amber-solid">
            Leer en Amazon →
          </a>
          <a href="/demo" class="btn-amber">
            Leer gratis la demo
          </a>
        </div>
      </div>

      <!-- Siguiente artículo -->
      <div class="mt-16">
        <p class="font-mono text-[0.6rem] tracking-[0.4em] text-[var(--color-muted)] uppercase mb-4">
          Siguiente artículo
        </p>
        <a href={`/blog/${next.slug}`}
           class="group flex items-start justify-between gap-6 py-6 border-t border-[var(--color-border)] hover:border-[rgba(163,21,21,0.3)] transition-colors duration-300">
          <div>
            <h3 class="font-serif text-[1.2rem] text-[var(--color-text)] leading-tight group-hover:text-[var(--color-amber)] transition-colors duration-300">
              {next.titulo}
            </h3>
            <p class="font-sans text-[var(--color-muted)] text-[0.85rem] mt-2 max-w-md leading-relaxed line-clamp-2">
              {next.extracto}
            </p>
          </div>
          <span class="font-mono text-[0.7rem] tracking-[0.2em] uppercase text-[var(--color-amber)] shrink-0 self-center group-hover:translate-x-1 transition-transform duration-300">→</span>
        </a>
      </div>

    </div>
  </main>
</Base>

<script>
  function initBlogPost() {
    // ── Reading progress bar ──────────────────────────────
    const bar = document.getElementById('post-progress');
    const content = document.querySelector<HTMLElement>('.post-content');
    if (bar && content) {
      const update = () => {
        const rect = content.getBoundingClientRect();
        const total = content.offsetHeight - window.innerHeight;
        const scrolled = -rect.top;
        const progress = Math.max(0, Math.min(1, scrolled / total));
        bar.style.width = (progress * 100) + '%';
      };
      window.addEventListener('scroll', update, { passive: true });
      update();
    }

    // ── Copy link ─────────────────────────────────────────
    const copyBtn = document.getElementById('copy-link');
    const copyIcon   = document.getElementById('copy-icon');
    const copyOkIcon = document.getElementById('copy-ok-icon');
    if (copyBtn && copyIcon && copyOkIcon) {
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
          copyIcon.style.display   = 'none';
          copyOkIcon.style.display = 'block';
          setTimeout(() => {
            copyIcon.style.display   = 'block';
            copyOkIcon.style.display = 'none';
          }, 1800);
        } catch {
          // fallback silencioso
        }
      });
    }
  }

  document.addEventListener('astro:page-load', initBlogPost);
</script>

<style>
  /* ── Reading progress bar ──────────────────────────────── */
  .post-progress {
    position: fixed;
    top: 3.5rem;
    left: 0;
    height: 2px;
    width: 0%;
    background: linear-gradient(90deg, #7B0F0F, #C41E1E);
    z-index: 9990;
    box-shadow: 0 0 14px rgba(163,21,21,0.6);
    transition: width 0.05s linear;
    pointer-events: none;
  }

  /* ── Share sidebar ─────────────────────────────────────── */
  .share-sidebar {
    position: fixed;
    left: 1.5rem;
    top: 50%;
    transform: translateY(-50%);
    z-index: 30;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    padding: 1rem 0.65rem;
    background: rgba(17,13,14,0.6);
    border: 1px solid rgba(163,21,21,0.15);
    backdrop-filter: blur(8px);
    border-radius: 999px;
  }
  .share-label {
    font-family: 'DM Mono', monospace;
    font-size: 0.5rem;
    letter-spacing: 0.3em;
    color: var(--color-muted);
    text-transform: uppercase;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    margin-bottom: 0.25rem;
  }
  .share-link {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: transparent;
    border: 1px solid rgba(255,255,255,0.08);
    color: var(--color-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: background 0.25s, border-color 0.25s, color 0.25s, transform 0.2s;
    cursor: pointer;
  }
  .share-link:hover {
    background: rgba(163,21,21,0.18);
    border-color: rgba(163,21,21,0.6);
    color: var(--color-text);
    transform: scale(1.08);
  }

  @media (max-width: 1100px) {
    .share-sidebar {
      position: static;
      transform: none;
      flex-direction: row;
      max-width: 24rem;
      margin: 2.5rem auto 0;
      border-radius: 999px;
    }
    .share-label {
      writing-mode: horizontal-tb;
      transform: none;
      margin-bottom: 0;
      margin-right: 0.5rem;
    }
  }

  /* Estilo tipográfico del cuerpo del post */
  .post-content :global(p) {
    margin-bottom: 1.5rem;
    max-width: 65ch;
  }

  .post-content :global(p:first-child::first-letter) {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 3.8rem;
    font-weight: 700;
    line-height: 0.85;
    float: left;
    margin-right: 0.1em;
    margin-top: 0.05em;
    color: #A31515;
  }

  .post-content :global(h2) {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.35rem, 3vw, 1.75rem);
    color: var(--color-text);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.2;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    max-width: 65ch;
  }

  .post-content :global(em) {
    font-family: 'Lora', Georgia, serif;
    font-style: italic;
    color: var(--color-text);
  }

  .post-content :global(strong) {
    color: var(--color-text);
    font-weight: 600;
  }

  @media (prefers-reduced-motion: no-preference) {
    .post-content :global(p),
    .post-content :global(h2) {
      animation: fadeUp 0.6s ease both;
    }
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(16px); }
      to   { opacity: 1; transform: translateY(0); }
    }
  }
</style>
