---
import Base         from '../layouts/Base.astro';
import Splash       from '../components/Splash.astro';
import Hero         from '../components/Hero.astro';
import LaFecha      from '../components/LaFecha.astro';
import Contador     from '../components/Contador.astro';
import SobreElLibro from '../components/SobreElLibro.astro';
import Timeline     from '../components/Timeline.astro';
import Fragmento    from '../components/Fragmento.astro';
import DemoCTA      from '../components/DemoCTA.astro';
import SobreElias   from '../components/SobreElias.astro';
import LibretaVerde from '../components/LibretaVerde.astro';
import Resenyas     from '../components/Resenyas.astro';
// import Blog         from '../components/Blog.astro';  // Oculto hasta tener contenido
import Newsletter   from '../components/Newsletter.astro';
import Contacto     from '../components/Contacto.astro';
import Footer       from '../components/Footer.astro';
import StickyCTA    from '../components/StickyCTA.astro';
---

<Base
  title="29 de Mayo | Elías Alcedo Espinosa"
  description="Descubre '29 de Mayo' de Elías Alcedo Espinosa. Un relato literario íntimo y honesto sobre el duelo, la familia y la resiliencia tras la trágica pérdida de un ser querido."
>
  <Splash />
  <Hero />
  <LaFecha />
  <Contador />
  <SobreElLibro />
  <Timeline />
  <Fragmento />
  <DemoCTA />
  <SobreElias />
  <LibretaVerde />
  <Resenyas />
  {/* <Blog />  Oculto hasta tener al menos 3 posts */}
  <Newsletter />
  <Contacto />
  <Footer />
  <StickyCTA />
</Base>
