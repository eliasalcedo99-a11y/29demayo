---
import Base from '../layouts/Base.astro';
import AmbientLayer from '../components/AmbientLayer.astro';
---

<Base 
  title="404 — Página no encontrada | 29 de Mayo"
  description="Esta página no existe. Como algunos recuerdos."
>
  <AmbientLayer />

  <main class="min-h-screen flex items-center justify-center px-6 relative z-10">
    <div class="max-w-2xl w-full text-center space-y-8 select-none">
      <!-- Decoración superior sutil -->
      <div class="flex justify-center items-center gap-3" aria-hidden="true">
        <span class="w-8 h-[1px] bg-amber/30"></span>
        <span class="w-2 h-2 rounded-full border border-amber/55 animate-pulse-amber"></span>
        <span class="w-8 h-[1px] bg-amber/30"></span>
      </div>

      <!-- Título de error -->
      <h1 class="text-[8rem] md:text-[12rem] font-serif font-extralight tracking-widest text-amber leading-none select-none tabular-nums filter drop-shadow-[0_0_20px_rgba(163,21,21,0.15)]">
        404
      </h1>

      <!-- Mensaje literario -->
      <p class="font-serif italic text-xl md:text-2xl text-text max-w-md mx-auto leading-relaxed">
        "Esta página no existe. Como algunos recuerdos."
      </p>

      <!-- Divisor sutil -->
      <div class="flex justify-center py-4" aria-hidden="true">
        <svg class="stroke-draw drawn w-32 h-6 opacity-35" viewBox="0 0 200 20" fill="none" stroke="currentColor">
          <path d="M0,10 C50,2 150,18 200,10" stroke-width="1" stroke-linecap="round" />
        </svg>
      </div>

      <!-- Enlace para volver -->
      <div class="pt-2">
        <a
          href="/"
          class="btn-amber inline-flex items-center gap-3 transition-all duration-300"
          data-cursor="Volver"
        >
          <span>←</span>
          <span>Volver al inicio</span>
        </a>
      </div>
    </div>
  </main>
</Base>

<style>
  /* Animación suave para la carga de la página 404 */
  main {
    animation: fadeIn 1.2s cubic-bezier(0.25, 1, 0.5, 1) forwards;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
