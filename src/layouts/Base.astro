---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = "Descubre '29 de Mayo' de Elías Alcedo Espinosa. Un relato íntimo sobre el duelo, la familia y la resiliencia.",
  ogImage = "/images/portada.jpg",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, 'https://29demayo.es');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#080608" />

    <!-- Open Graph -->
    <meta property="og:type"        content="book" />
    <meta property="og:url"         content={canonicalURL} />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={new URL(ogImage, 'https://29demayo.es')} />
    <meta property="og:locale"      content="es_ES" />
    <meta property="og:site_name"   content="29 de Mayo" />
    <meta property="book:author"    content="Elías Alcedo Espinosa" />

    <!-- Twitter / X -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={new URL(ogImage, 'https://29demayo.es')} />

    <!-- Preload fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=DM+Mono:ital,wght@0,300;0,400;1,300&family=Lora:ital,wght@0,400;1,400;1,500&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet">

    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <div id="scroll-progress" aria-hidden="true"></div>
    <div id="cursor-dot"  aria-hidden="true"></div>
    <div id="cursor-ring" aria-hidden="true"></div>

    <slot />

    <script>
      import Lenis from 'lenis';
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      // Lenis singleton — created once, survives ViewTransitions
      let lenis: InstanceType<typeof Lenis> | null = null;
      let cursorReady = false;

      function boot() {
        // ── Smooth scroll ─────────────────────────────────────
        if (!lenis) {
          lenis = new Lenis({
            duration: 1.2,
            easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
            orientation: 'vertical' as const,
            gestureOrientation: 'vertical' as const,
            smoothWheel: true,
            wheelMultiplier: 1,
            touchMultiplier: 2,
          });
          lenis.on('scroll', ScrollTrigger.update);
          gsap.ticker.add((time: number) => lenis?.raf(time * 1000));
          gsap.ticker.lagSmoothing(0);
        }

        // ── Scroll progress bar ───────────────────────────────
        const bar = document.getElementById('scroll-progress');
        if (bar) {
          ScrollTrigger.create({
            trigger: document.body,
            start: 'top top',
            end: 'bottom bottom',
            onUpdate: (self) => { bar.style.width = (self.progress * 100) + '%'; },
          });
        }

        // ── Cursor follower (pointer devices only, init once) ─
        if (!cursorReady && matchMedia('(pointer: fine)').matches) {
          cursorReady = true;
          const dot  = document.getElementById('cursor-dot');
          const ring = document.getElementById('cursor-ring');

          if (dot && ring) {
            // Activar custom cursor: ahora el CSS oculta el nativo
            document.body.classList.add('has-custom-cursor');
            gsap.set([dot, ring], { xPercent: -50, yPercent: -50, opacity: 0 });

            const moveDotX  = gsap.quickTo(dot,  'x', { duration: 0.05 });
            const moveDotY  = gsap.quickTo(dot,  'y', { duration: 0.05 });
            const moveRingX = gsap.quickTo(ring, 'x', { duration: 0.35, ease: 'power3.out' });
            const moveRingY = gsap.quickTo(ring, 'y', { duration: 0.35, ease: 'power3.out' });

            let entered = false;
            window.addEventListener('mousemove', (e) => {
              if (!entered) { gsap.to([dot, ring], { opacity: 1, duration: 0.4 }); entered = true; }
              moveDotX(e.clientX); moveDotY(e.clientY);
              moveRingX(e.clientX); moveRingY(e.clientY);
            });

            const inflate = () => {
              gsap.to(ring, { scale: 1.9, borderColor: 'rgba(163,21,21,0.65)', duration: 0.25 });
              gsap.to(dot,  { scale: 0.4, duration: 0.25 });
            };
            const deflate = () => {
              gsap.to(ring, { scale: 1, borderColor: 'rgba(163,21,21,0.45)', duration: 0.35 });
              gsap.to(dot,  { scale: 1, duration: 0.35 });
            };

            document.addEventListener('mouseover', (e) => {
              if ((e.target as Element)?.closest('a, button, [role="button"], label')) inflate();
            });
            document.addEventListener('mouseout', (e) => {
              if ((e.target as Element)?.closest('a, button, [role="button"], label')) deflate();
            });
            document.addEventListener('mousedown', () => gsap.to([dot, ring], { scale: 0.7, duration: 0.1 }));
            document.addEventListener('mouseup',   () => gsap.to([dot, ring], { scale: 1, duration: 0.2 }));
          }
        }

        // ── Magnetic buttons (re-bind on each navigation) ─────
        document.querySelectorAll<HTMLElement>('.btn-amber').forEach((btn) => {
          const move = (e: MouseEvent) => {
            const r  = btn.getBoundingClientRect();
            const dx = ((e.clientX - r.left) / r.width  - 0.5) * 10;
            const dy = ((e.clientY - r.top)  / r.height - 0.5) * 6;
            gsap.to(btn, { x: dx, y: dy, duration: 0.25, ease: 'power2.out' });
          };
          const reset = () => gsap.to(btn, { x: 0, y: 0, duration: 0.5, ease: 'elastic.out(1, 0.4)' });
          btn.addEventListener('mousemove', move);
          btn.addEventListener('mouseleave', reset);
        });

        ScrollTrigger.refresh();
      }

      // Fires on initial load AND after every ViewTransition
      document.addEventListener('astro:page-load', boot);
    </script>
  </body>
</html>
