---
---

<footer
  class="bg-[var(--color-bg)] border-t border-[var(--color-border)] py-12 px-6"
  aria-label="Pie de página"
>
  <div class="max-w-6xl mx-auto flex flex-col items-center gap-8">

    <!-- Logo textual -->
    <a
      href="#"
      class="inline-flex items-center min-h-[44px] font-serif text-[1.4rem] text-[var(--color-text)] hover:text-[var(--color-amber)] transition-colors duration-300"
      aria-label="Volver al inicio"
    >
      29 de Mayo
    </a>

    <!-- Social / links -->
    <nav aria-label="Redes sociales y enlaces">
      <ul class="flex flex-wrap items-center justify-center gap-6">
        <li>
          <a
            href="https://www.instagram.com/eliasalcedo04"
            target="_blank"
            rel="noopener noreferrer"
            class="link-underline inline-flex items-center min-h-[44px] font-mono text-[0.7rem] tracking-[0.25em] text-[var(--color-muted)] hover:text-[var(--color-amber)] transition-colors duration-300 uppercase"
          >
            Instagram
          </a>
        </li>
        <li aria-hidden="true" class="text-[var(--color-border)]">·</li>
        <li>
          <a
            href="https://amzn.to/3RlmkaH"
            target="_blank"
            rel="noopener noreferrer"
            class="link-underline inline-flex items-center min-h-[44px] font-mono text-[0.7rem] tracking-[0.25em] text-[var(--color-muted)] hover:text-[var(--color-amber)] transition-colors duration-300 uppercase"
          >
            Amazon Ebook
          </a>
        </li>
        <li aria-hidden="true" class="text-[var(--color-border)]">·</li>
        <li>
          <a
            href="https://amzn.to/4tIcIo0"
            target="_blank"
            rel="noopener noreferrer"
            class="link-underline inline-flex items-center min-h-[44px] font-mono text-[0.7rem] tracking-[0.25em] text-[var(--color-muted)] hover:text-[var(--color-amber)] transition-colors duration-300 uppercase"
          >
            Tapa Blanda
          </a>
        </li>
        <li aria-hidden="true" class="text-[var(--color-border)]">·</li>
        <li>
          <a
            href="/demo"
            class="link-underline inline-flex items-center min-h-[44px] font-mono text-[0.7rem] tracking-[0.25em] text-[var(--color-muted)] hover:text-[var(--color-amber)] transition-colors duration-300 uppercase"
          >
            Demo
          </a>
        </li>
      </ul>
    </nav>

    <!-- Divider -->
    <div class="w-16 h-px bg-[var(--color-border)]"></div>

    <!-- Copyright + legal -->
    <div class="flex flex-col md:flex-row items-center gap-3 text-center">
      <p class="font-mono text-[0.65rem] tracking-[0.2em] text-[var(--color-muted)]">
        © 2026 · Elías Alcedo Espinosa · Cádiz
      </p>
      <span class="hidden md:block text-[var(--color-border)]">·</span>
      <nav aria-label="Legal">
        <ul class="flex gap-4">
          <li>
            <a
              href="/aviso-legal"
              class="inline-flex items-center min-h-[44px] font-mono text-[0.6rem] tracking-[0.2em] text-[var(--color-muted)]/60 hover:text-[var(--color-muted)] transition-colors duration-300 uppercase"
            >
              Aviso legal
            </a>
          </li>
          <li>
            <a
              href="/privacidad"
              class="inline-flex items-center min-h-[44px] font-mono text-[0.6rem] tracking-[0.2em] text-[var(--color-muted)]/60 hover:text-[var(--color-muted)] transition-colors duration-300 uppercase"
            >
              Privacidad
            </a>
          </li>
        </ul>
      </nav>
    </div>

    <!-- Final note -->
    <p class="font-mono text-[0.58rem] tracking-[0.3em] text-[var(--color-muted)]/35 text-center uppercase">
      Escrito en Cádiz · 2023
    </p>

  </div>
</footer>
