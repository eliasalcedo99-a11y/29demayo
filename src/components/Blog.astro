---
import { posts } from '../data/posts';
---

<section
  id="blog"
  class="bg-[var(--color-surface)] py-28 px-6"
  aria-label="Blog y reflexiones"
>
  <div class="max-w-6xl mx-auto">

    <div class="flex items-end justify-between mb-14">
      <div>
        <span class="section-label">Blog</span>
        <h2 class="font-serif text-[clamp(2rem,4vw,3rem)] text-[var(--color-text)]">
          Reflexiones
        </h2>
      </div>
      <a
        href="/blog"
        class="hidden md:flex items-center gap-2 font-mono text-[0.7rem] tracking-[0.2em] text-[var(--color-muted)] hover:text-[var(--color-amber)] transition-colors duration-300 uppercase"
      >
        Ver todos ↗
      </a>
    </div>

    <!-- Grid -->
    <div class="grid md:grid-cols-3 gap-8">
      {posts.map((post, i) => (
        <article
          class="blog-card group relative overflow-hidden bg-[var(--color-bg)] rounded-sm opacity-0"
          style={`--delay: ${i * 0.12}s`}
        >
          <!-- Color header (editorial, sin imagen) -->
          <div
            class="relative h-36 overflow-hidden flex items-end p-4"
            style={`background: ${post.temaColor}; border-bottom: 1px solid rgba(163,21,21,0.12);`}
          >
            <!-- Tipo badge -->
            <span class="font-mono text-[0.58rem] tracking-[0.2em] uppercase bg-[var(--color-amber)] text-[var(--color-bg)] px-2 py-0.5">
              {post.tipo === 'video' ? '▶ Vídeo' : '✍ Artículo'}
            </span>
          </div>

          <!-- Card body -->
          <div class="p-6">
            <time datetime={post.fechaISO} class="font-mono text-[0.65rem] tracking-[0.3em] text-[var(--color-muted)] uppercase block mb-3">
              {post.fecha}
            </time>
            <h3 class="font-serif text-[1.1rem] text-[var(--color-text)] leading-tight mb-3 group-hover:text-[var(--color-amber)] transition-colors duration-300">
              {post.titulo}
            </h3>
            <p class="font-sans text-[0.85rem] text-[var(--color-muted)] leading-relaxed line-clamp-3">
              {post.extracto}
            </p>
          </div>

          <!-- Invisible full-card link -->
          <a
            href={`/blog/${post.slug}`}
            class="absolute inset-0"
            aria-label={`Leer: ${post.titulo}`}
          ></a>
        </article>
      ))}
    </div>

    <!-- Mobile ver todos -->
    <div class="md:hidden mt-8 text-center">
      <a
        href="/blog"
        class="font-mono text-[0.7rem] tracking-[0.2em] text-[var(--color-muted)] hover:text-[var(--color-amber)] transition-colors uppercase"
      >
        Ver todos los artículos ↗
      </a>
    </div>

  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  let blogTriggers: any[] = [];

  function initBlog() {
    cleanupBlog();

    gsap.utils.toArray<HTMLElement>('.blog-card').forEach((card) => {
      const delay = parseFloat(card.style.getPropertyValue('--delay')) || 0;
      gsap.set(card, { opacity: 0, y: 32 });
      const anim = gsap.fromTo(card,
        { opacity: 0, y: 32 },
        {
          opacity: 1,
          y: 0,
          duration: 0.8,
          ease: 'power3.out',
          delay,
          scrollTrigger: {
            trigger: card,
            start: 'top 84%',
            once: true,
          },
        }
      );
      if (anim.scrollTrigger) blogTriggers.push(anim.scrollTrigger);
    });
  }

  function cleanupBlog() {
    blogTriggers.forEach(t => t.kill());
    blogTriggers = [];
  }

  document.addEventListener('astro:page-load', initBlog);
  document.addEventListener('astro:before-swap', cleanupBlog);
</script>
