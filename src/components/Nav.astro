---
const amazonEbook = 'https://amzn.to/3RlmkaH';

const links = [
  { label: 'El libro',  href: '#sobre-el-libro' },
  { label: 'El año',    href: '#timeline-section' },
  { label: 'Demo',      href: '/demo' },
  { label: 'El autor',  href: '#sobre-elias' },
  { label: 'Blog',      href: '#blog' },
];
---

<nav
  id="main-nav"
  class="fixed top-0 left-0 right-0 z-[9980] transition-none"
  aria-label="Navegación principal"
>
  <!-- Backdrop -->
  <div
    id="nav-backdrop"
    class="absolute inset-0 opacity-0 transition-opacity duration-500 pointer-events-none"
    style="background: rgba(8,6,8,0.88); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-bottom: 1px solid rgba(163,21,21,0.12);"
    aria-hidden="true"
  ></div>

  <div class="relative flex items-center justify-between h-14 px-6 md:px-10 max-w-7xl mx-auto">

    <!-- Logo -->
    <a
      href="#"
      id="nav-logo"
      class="inline-flex items-center font-serif text-[1.1rem] text-[var(--color-text)] opacity-0 transition-colors duration-300 hover:text-[var(--color-amber)] py-3 -my-3"
      style="letter-spacing: -0.02em; min-height: 44px;"
      aria-label="Inicio — 29 de Mayo"
    >
      29 de Mayo
    </a>

    <!-- Links desktop -->
    <ul
      id="nav-links"
      class="hidden md:flex items-center gap-5 opacity-0"
      role="list"
    >
      {links.map((l) => (
        <li class="flex">
          <a
            href={l.href}
            class="nav-link inline-flex items-center px-2 font-mono text-[0.62rem] tracking-[0.28em] uppercase text-[var(--color-muted)] hover:text-[var(--color-text)] transition-colors duration-300"
            style="min-height: 44px;"
          >
            {l.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- CTA + Hamburger -->
    <div class="flex items-center gap-4">
      <a
        href={amazonEbook}
        target="_blank"
        rel="noopener noreferrer"
        id="nav-cta"
        class="hidden md:inline-flex btn-amber btn-amber-solid opacity-0"
        style="padding: 0.6rem 1.1rem; font-size: 0.62rem; min-height: 44px;"
      >
        Comprar →
      </a>

      <!-- Hamburger (mobile) -->
      <button
        id="nav-hamburger"
        class="md:hidden flex flex-col justify-center items-center w-11 h-11 gap-1.5 opacity-0"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="nav-mobile-menu"
      >
        <span class="nav-bar block w-5 h-px bg-[var(--color-text)] transition-all duration-300 origin-center"></span>
        <span class="nav-bar block w-5 h-px bg-[var(--color-text)] transition-all duration-300"></span>
        <span class="nav-bar block w-5 h-px bg-[var(--color-text)] transition-all duration-300 origin-center"></span>
      </button>
    </div>

  </div>
</nav>

<!-- Mobile full-screen menu -->
<div
  id="nav-mobile-menu"
  class="fixed inset-0 z-[9970] flex flex-col items-center justify-center gap-10 pointer-events-none opacity-0 transition-opacity duration-400"
  style="background: rgba(8,6,8,0.97); backdrop-filter: blur(20px);"
  role="dialog"
  aria-modal="true"
  aria-label="Menú principal"
>
  <ul class="flex flex-col items-center gap-8" role="list">
    {links.map((l) => (
      <li>
        <a
          href={l.href}
          class="mobile-nav-link font-serif text-[clamp(1.6rem,8vw,2.8rem)] text-[var(--color-text)] hover:text-[var(--color-amber)] transition-colors duration-300"
          style="letter-spacing: -0.02em;"
        >
          {l.label}
        </a>
      </li>
    ))}
  </ul>

  <a
    href={amazonEbook}
    target="_blank"
    rel="noopener noreferrer"
    class="btn-amber btn-amber-solid"
    onclick="document.getElementById('nav-hamburger').click()"
  >
    Comprar en Amazon →
  </a>

  <button
    id="nav-mobile-close"
    class="absolute top-3 right-3 inline-flex items-center justify-center px-4 font-mono text-[0.65rem] tracking-[0.3em] text-[var(--color-muted)] uppercase hover:text-[var(--color-text)] transition-colors duration-300"
    style="min-height: 44px; min-width: 44px;"
    aria-label="Cerrar menú"
  >
    Cerrar ×
  </button>
</div>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  function initNav() {
    const nav       = document.getElementById('main-nav');
    const backdrop  = document.getElementById('nav-backdrop');
    const logo      = document.getElementById('nav-logo');
    const navLinks  = document.getElementById('nav-links');
    const navCta    = document.getElementById('nav-cta');
    const hamburger = document.getElementById('nav-hamburger');
    const mobileMenu = document.getElementById('nav-mobile-menu');
    const mobileClose = document.getElementById('nav-mobile-close');

    if (!nav || !backdrop) return;

    // ── Aparece tras pasar el hero ─────────────────────────────
    const heroEl = document.getElementById('hero');
    const heroH  = heroEl?.offsetHeight ?? window.innerHeight;

    // Estado inicial: todo invisible
    gsap.set([logo, navLinks, navCta, hamburger], { opacity: 0 });

    let navVisible = false;

    function showNav() {
      if (navVisible) return;
      navVisible = true;
      backdrop.style.opacity = '1';
      gsap.to([logo, navLinks, navCta, hamburger], {
        opacity: 1,
        duration: 0.55,
        ease: 'power2.out',
        stagger: 0.06,
      });
    }

    function hideNav() {
      if (!navVisible) return;
      navVisible = false;
      backdrop.style.opacity = '0';
      gsap.to([logo, navLinks, navCta, hamburger], {
        opacity: 0,
        duration: 0.35,
        ease: 'power2.in',
      });
    }

    function onScroll() {
      if (window.scrollY > heroH * 0.75) {
        showNav();
      } else {
        hideNav();
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll(); // check on load

    // ── Smooth scroll para anchor links ───────────────────────
    nav.querySelectorAll('a[href^="#"]').forEach((a) => {
      a.addEventListener('click', (e) => {
        const href = (a as HTMLAnchorElement).getAttribute('href');
        if (!href || href === '#') return;
        const target = document.querySelector(href);
        if (!target) return;
        e.preventDefault();
        closeMenu();
        // Lenis ya gestiona el smooth scroll, scroll nativo es suficiente
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });

    // ── Hamburger / mobile menu ───────────────────────────────
    let menuOpen = false;
    const bars = hamburger?.querySelectorAll<HTMLElement>('.nav-bar');

    function openMenu() {
      menuOpen = true;
      hamburger?.setAttribute('aria-expanded', 'true');
      if (mobileMenu) {
        mobileMenu.style.pointerEvents = 'auto';
        gsap.to(mobileMenu, { opacity: 1, duration: 0.35, ease: 'power2.out' });
      }
      if (bars && bars.length >= 3) {
        gsap.to(bars[0], { rotate:  45, y:  7, duration: 0.3 });
        gsap.to(bars[1], { opacity: 0, duration: 0.2 });
        gsap.to(bars[2], { rotate: -45, y: -7, duration: 0.3 });
      }
      document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
      if (!menuOpen) return;
      menuOpen = false;
      hamburger?.setAttribute('aria-expanded', 'false');
      if (mobileMenu) {
        mobileMenu.style.pointerEvents = 'none';
        gsap.to(mobileMenu, { opacity: 0, duration: 0.25, ease: 'power2.in' });
      }
      if (bars && bars.length >= 3) {
        gsap.to(bars[0], { rotate: 0, y: 0, duration: 0.3 });
        gsap.to(bars[1], { opacity: 1, duration: 0.2 });
        gsap.to(bars[2], { rotate: 0, y: 0, duration: 0.3 });
      }
      document.body.style.overflow = '';
    }

    hamburger?.addEventListener('click', () => menuOpen ? closeMenu() : openMenu());
    mobileClose?.addEventListener('click', closeMenu);

    // Cerrar con Escape
    const onKey = (e: KeyboardEvent) => { if (e.key === 'Escape') closeMenu(); };
    window.addEventListener('keydown', onKey);

    // Cerrar al hacer clic en links del mobile menu
    mobileMenu?.querySelectorAll('a').forEach((a) => {
      a.addEventListener('click', closeMenu);
    });
  }

  document.addEventListener('astro:page-load', initNav);
</script>

<style>
  /* Underline animado en los links del nav */
  .nav-link {
    position: relative;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--color-amber);
    transition: width 0.3s ease;
  }
  .nav-link:hover::after {
    width: 100%;
  }

  /* Active link highlight */
  .nav-link.is-active {
    color: var(--color-text);
  }
  .nav-link.is-active::after {
    width: 100%;
    background: rgba(163,21,21,0.6);
  }
</style>
