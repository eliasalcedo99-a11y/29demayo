---
/**
 * AskBook — Widget de chat "Pregunta al libro"
 * Una IA responde preguntas sobre el contenido del libro sin spoilers.
 *
 * Sin clave API configurada, responde con frases pre-escritas elegantes
 * que invitan a comprar / leer la demo. Con clave configurada, llama
 * a /api/ask-book que internamente usa Claude API con el texto del libro.
 */
---

<!-- Botón flotante -->
<button
  id="ask-book-trigger"
  class="ask-book-trigger"
  aria-label="Preguntar al libro"
  aria-expanded="false"
>
  <span class="ask-pulse" aria-hidden="true"></span>
  <span class="ask-icon" aria-hidden="true">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
    </svg>
  </span>
  <span class="ask-text">Pregunta al libro</span>
</button>

<!-- Modal del chat -->
<div id="ask-book-modal" class="ask-modal" role="dialog" aria-modal="true" aria-labelledby="ask-title" aria-hidden="true">

  <div class="ask-backdrop" id="ask-backdrop"></div>

  <div class="ask-panel">

    <!-- Header -->
    <div class="ask-header">
      <div class="ask-header-left">
        <span class="ask-eyebrow">Pregunta al libro</span>
        <h3 id="ask-title" class="ask-title">29 de Mayo</h3>
      </div>
      <button id="ask-close" class="ask-close" aria-label="Cerrar">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>

    <!-- Mensajes -->
    <div class="ask-messages" id="ask-messages">
      <!-- Mensaje de bienvenida -->
      <div class="ask-msg ask-msg-bot">
        <div class="ask-msg-meta">
          <span class="ask-msg-author">29 de Mayo · IA</span>
        </div>
        <p>
          Hola. Puedo responder preguntas sobre el libro sin destripar la historia.
          Pregúntame por los personajes, los temas, el tono, o por qué Elías decidió escribirlo.
        </p>
      </div>

      <!-- Sugerencias -->
      <div class="ask-suggestions" id="ask-suggestions">
        <button class="ask-chip" data-prompt="¿De qué trata el libro?">¿De qué trata?</button>
        <button class="ask-chip" data-prompt="¿Quién es Kike?">¿Quién es Kike?</button>
        <button class="ask-chip" data-prompt="¿Por qué tengo que leerlo?">¿Por qué leerlo?</button>
        <button class="ask-chip" data-prompt="¿Es triste todo el libro?">¿Es muy triste?</button>
      </div>
    </div>

    <!-- Input -->
    <form id="ask-form" class="ask-form" novalidate>
      <input
        id="ask-input"
        type="text"
        autocomplete="off"
        spellcheck="false"
        placeholder="Escribe tu pregunta…"
        maxlength="200"
      />
      <button type="submit" class="ask-send" aria-label="Enviar">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/>
        </svg>
      </button>
    </form>

    <p class="ask-disclaimer">
      Respuestas generadas por IA basadas en el libro. No sustituyen al texto real.
    </p>

  </div>
</div>

<style>
  /* ── Botón flotante ─────────────────────────────────────── */
  .ask-book-trigger {
    position: fixed;
    bottom: 1.75rem;
    left: 1.75rem;
    z-index: 9985;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.7rem 1.05rem 0.7rem 0.85rem;
    background: rgba(17,13,14,0.92);
    color: var(--color-text);
    border: 1px solid rgba(163,21,21,0.4);
    border-radius: 999px;
    font-family: 'DM Mono', monospace;
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    cursor: pointer;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 8px 28px rgba(0,0,0,0.55), 0 0 18px rgba(163,21,21,0.18);
    transition: background 0.25s, border-color 0.25s, transform 0.25s, box-shadow 0.25s;
    opacity: 0;
    transform: translateY(20px);
    pointer-events: none;
  }
  .ask-book-trigger.visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  .ask-book-trigger:hover {
    background: rgba(26,18,20,0.97);
    border-color: rgba(163,21,21,0.7);
    transform: translateY(-2px);
    box-shadow: 0 12px 36px rgba(0,0,0,0.65), 0 0 26px rgba(163,21,21,0.3);
  }

  .ask-pulse {
    position: absolute;
    top: 0.5rem;
    right: 0.6rem;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-amber-light);
    box-shadow: 0 0 8px rgba(196,30,30,0.9);
  }
  .ask-pulse::after {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    border: 1px solid rgba(196,30,30,0.7);
    animation: ask-pulse-ring 2s ease-in-out infinite;
  }
  @keyframes ask-pulse-ring {
    0%   { transform: scale(0.8); opacity: 0.9; }
    100% { transform: scale(2.2); opacity: 0; }
  }

  /* Mobile: sólo icono */
  @media (max-width: 720px) {
    .ask-text { display: none; }
    .ask-book-trigger {
      padding: 0.75rem;
      bottom: 1.25rem;
      left: 1.25rem;
    }
  }

  /* En LaFecha y Fragmento: silenciar el trigger */
  body.sticky-mute .ask-book-trigger {
    opacity: 0 !important;
    pointer-events: none !important;
  }

  /* ── Modal ────────────────────────────────────────────── */
  .ask-modal {
    position: fixed;
    inset: 0;
    z-index: 9995;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s ease;
  }
  .ask-modal.open {
    opacity: 1;
    pointer-events: auto;
  }

  .ask-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(8,6,8,0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .ask-panel {
    position: relative;
    width: 100%;
    max-width: 36rem;
    height: min(82vh, 640px);
    display: flex;
    flex-direction: column;
    background: rgba(17,13,14,0.96);
    border: 1px solid rgba(163,21,21,0.18);
    border-radius: 2px;
    box-shadow: 0 30px 90px rgba(0,0,0,0.7), 0 0 60px rgba(163,21,21,0.08);
    overflow: hidden;
    transform: translateY(20px) scale(0.97);
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .ask-modal.open .ask-panel {
    transform: translateY(0) scale(1);
  }

  /* Header */
  .ask-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 1.25rem 1.5rem 1rem;
    border-bottom: 1px solid rgba(163,21,21,0.12);
  }
  .ask-eyebrow {
    display: block;
    font-family: 'DM Mono', monospace;
    font-size: 0.58rem;
    letter-spacing: 0.4em;
    color: var(--color-amber);
    text-transform: uppercase;
    margin-bottom: 0.3rem;
  }
  .ask-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.3rem;
    color: var(--color-text);
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .ask-close {
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: transparent;
    border: 1px solid rgba(242,234,224,0.1);
    color: var(--color-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }
  .ask-close:hover {
    color: var(--color-text);
    border-color: rgba(242,234,224,0.3);
    background: rgba(255,255,255,0.05);
  }

  /* Mensajes */
  .ask-messages {
    flex: 1;
    overflow-y: auto;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    scroll-behavior: smooth;
  }
  .ask-messages::-webkit-scrollbar { width: 4px; }
  .ask-messages::-webkit-scrollbar-thumb {
    background: rgba(163,21,21,0.25);
    border-radius: 2px;
  }
  .ask-messages::-webkit-scrollbar-track { background: transparent; }

  .ask-msg {
    max-width: 90%;
    animation: ask-msg-in 0.5s ease;
  }
  @keyframes ask-msg-in {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .ask-msg-meta {
    margin-bottom: 0.35rem;
  }
  .ask-msg-author {
    font-family: 'DM Mono', monospace;
    font-size: 0.55rem;
    letter-spacing: 0.35em;
    color: var(--color-amber);
    text-transform: uppercase;
  }
  .ask-msg p {
    font-family: 'Lora', Georgia, serif;
    font-size: 0.92rem;
    line-height: 1.65;
    color: var(--color-text);
    max-width: none;
  }
  .ask-msg em {
    color: var(--color-amber-light);
  }

  .ask-msg-user {
    align-self: flex-end;
  }
  .ask-msg-user p {
    font-family: 'DM Mono', monospace;
    font-size: 0.82rem;
    letter-spacing: 0;
    background: rgba(163,21,21,0.12);
    border: 1px solid rgba(163,21,21,0.22);
    padding: 0.7rem 1rem;
    border-radius: 2px;
    color: var(--color-text);
  }
  .ask-msg-user .ask-msg-author { color: var(--color-muted); }

  /* Indicador de "escribiendo" */
  .ask-msg-typing p {
    display: inline-flex;
    gap: 0.25rem;
    padding: 0.65rem 0.9rem;
  }
  .ask-msg-typing p::before {
    content: '';
    display: inline-block;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--color-amber);
    animation: typing-dot 1.2s ease-in-out infinite;
  }
  .ask-msg-typing p::after {
    content: '· ·';
    color: var(--color-amber);
    letter-spacing: 0.4em;
    animation: typing-dot 1.2s ease-in-out infinite 0.2s;
  }
  @keyframes typing-dot {
    0%, 60%, 100% { opacity: 0.3; }
    30%           { opacity: 1; }
  }

  /* Chips de sugerencias */
  .ask-suggestions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }
  .ask-chip {
    background: transparent;
    border: 1px solid rgba(163,21,21,0.3);
    color: var(--color-text);
    font-family: 'DM Mono', monospace;
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.5rem 0.85rem;
    border-radius: 999px;
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s, color 0.2s;
  }
  .ask-chip:hover {
    background: rgba(163,21,21,0.12);
    border-color: rgba(163,21,21,0.55);
  }

  /* Form */
  .ask-form {
    display: flex;
    gap: 0.5rem;
    padding: 1rem 1.5rem 0.5rem;
    border-top: 1px solid rgba(163,21,21,0.12);
    background: rgba(8,6,8,0.55);
  }
  .ask-form input {
    flex: 1;
    background: transparent;
    border: 1px solid rgba(255,255,255,0.08);
    color: var(--color-text);
    font-family: 'Lora', Georgia, serif;
    font-size: 0.95rem;
    padding: 0.65rem 0.9rem;
    border-radius: 2px;
    outline: none;
    transition: border-color 0.2s;
  }
  .ask-form input:focus {
    border-color: var(--color-amber);
  }
  .ask-form input::placeholder {
    color: var(--color-muted);
    font-style: italic;
  }
  .ask-send {
    background: var(--color-amber);
    border: 1px solid var(--color-amber);
    color: var(--color-text);
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s, transform 0.15s;
  }
  .ask-send:hover {
    background: var(--color-amber-light);
    transform: scale(1.05);
  }
  .ask-send:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .ask-disclaimer {
    text-align: center;
    padding: 0.5rem 1.5rem 1rem;
    font-family: 'DM Mono', monospace;
    font-size: 0.55rem;
    letter-spacing: 0.2em;
    color: rgba(138,122,116,0.55);
    text-transform: uppercase;
  }
</style>

<script>
  function initAskBook() {
    const trigger     = document.getElementById('ask-book-trigger');
    const modal       = document.getElementById('ask-book-modal');
    const backdrop    = document.getElementById('ask-backdrop');
    const closeBtn    = document.getElementById('ask-close');
    const messages    = document.getElementById('ask-messages');
    const form        = document.getElementById('ask-form') as HTMLFormElement | null;
    const input       = document.getElementById('ask-input') as HTMLInputElement | null;
    const suggestions = document.getElementById('ask-suggestions');

    if (!trigger || !modal || !messages || !form || !input) return;

    // Aparece tras pasar el hero
    const heroEl = document.getElementById('hero');
    const heroH  = heroEl?.offsetHeight ?? window.innerHeight;

    function onScroll() {
      if (window.scrollY > heroH * 0.85) {
        trigger!.classList.add('visible');
      } else {
        trigger!.classList.remove('visible');
      }
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    function openModal() {
      modal!.classList.add('open');
      modal!.setAttribute('aria-hidden', 'false');
      trigger!.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      setTimeout(() => input!.focus(), 350);
    }

    function closeModal() {
      modal!.classList.remove('open');
      modal!.setAttribute('aria-hidden', 'true');
      trigger!.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }

    trigger.addEventListener('click', openModal);
    closeBtn?.addEventListener('click', closeModal);
    backdrop?.addEventListener('click', closeModal);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal!.classList.contains('open')) closeModal();
    });

    // Chips de sugerencias
    suggestions?.querySelectorAll<HTMLButtonElement>('.ask-chip').forEach((chip) => {
      chip.addEventListener('click', () => {
        const prompt = chip.dataset.prompt || chip.textContent || '';
        input!.value = prompt;
        form!.requestSubmit();
      });
    });

    // ── Respuestas pre-escritas (modo placeholder sin API) ──
    const fallbacks: { match: RegExp; reply: string }[] = [
      {
        match: /(de qu[éeè]|sobre qu[éeè]|trata|argumento|de qu[éeè] va)/i,
        reply: '<em>29 de Mayo</em> es la memoria del año 2023 contada mes a mes. El año en que perdí a mi tío Kike en un accidente de moto. No es un libro sobre el accidente, es un libro sobre lo que pasa después: el silencio, las preguntas que no encuentran respuesta, y la escritura como única forma de seguir respirando.',
      },
      {
        match: /(kike|t[ií]o|enrique)/i,
        reply: 'Kike — Enrique en realidad — era mi tío. La persona que me enseñó a respetar las motos sin tenerles miedo, y a estar presente sin necesidad de demasiadas palabras. Murió el 29 de mayo de 2023, en una curva, cuando una vaca se cruzó en su camino. El libro existe, en parte, para que él siga existiendo.',
      },
      {
        match: /(triste|deprimente|llorar|duro|llora)/i,
        reply: 'Sí, hay tristeza. No tendría sentido fingir lo contrario. Pero el libro no se queda en el dolor: también hay luz, recuerdos cálidos, momentos de risa y la lenta construcción de una manera de seguir. Los lectores me cuentan que se va leyendo con un nudo en la garganta y una sonrisa rara, las dos cosas a la vez.',
      },
      {
        match: /(por qu[éeè] (leer|lo).*|recomendar|vale la pena|merece la pena)/i,
        reply: 'Si has perdido a alguien, quizás encuentres aquí palabras que también son tuyas. Si no has perdido a nadie, quizás te ayude a entender lo que sienten quienes lo han hecho. Y si simplemente buscas literatura honesta, sin filtros ni adornos, también está ese motivo.',
      },
      {
        match: /(autor|qui[éeè]n eres|elías|alcedo|edad|años)/i,
        reply: 'Soy Elías Alcedo Espinosa. Nací en Cádiz, tengo 18 años, y escribo desde los quince. Empecé a escribir este libro sin saber que iba a serlo — empezó siendo una libreta verde que llevaba a clase. Ahora estudio marketing en Jerez y sigo escribiendo todos los días.',
      },
      {
        match: /(motos?|accidente|carretera|vaca)/i,
        reply: 'Las motos están en el libro porque estaban en mi vida. Kike y yo compartíamos esa pasión. El accidente ocurrió en moto, sí, pero no es un libro contra las motos. Es un libro sobre la fragilidad — sobre cómo todo lo bueno convive con su propia posibilidad de pérdida.',
      },
      {
        match: /(precio|comprar|d[oó]nde|amazon)/i,
        reply: 'Lo tienes en Amazon — versión ebook y tapa blanda. También puedes leer los primeros capítulos gratis en la <em>demo</em> de esta web antes de decidir. No hay registro ni nada raro.',
      },
      {
        match: /(libreta|verde|cuaderno)/i,
        reply: 'La libreta verde es real. Existió. La compré en una papelería del centro de Cádiz sin ningún plan, y se convirtió en el sitio donde todo lo que no podía decir terminaba escrito. El libro nace de esas páginas. En la web hay una sección donde puedes "tocarla" y leer algunos apuntes.',
      },
    ];

    function findFallbackReply(question: string): string {
      for (const f of fallbacks) {
        if (f.match.test(question)) return f.reply;
      }
      // Default reply
      return 'Esa es una buena pregunta. Por ahora sólo puedo responder sobre los grandes temas del libro: el accidente, mi tío Kike, la escritura como refugio, el duelo. Pero te animo a leer un fragmento gratis en la <em>demo</em> — quizás encuentres mejor la respuesta ahí.';
    }

    function addMessage(role: 'user' | 'bot', html: string) {
      const div = document.createElement('div');
      div.className = `ask-msg ask-msg-${role}`;
      div.innerHTML = `
        <div class="ask-msg-meta">
          <span class="ask-msg-author">${role === 'bot' ? '29 de Mayo · IA' : 'Tú'}</span>
        </div>
        <p>${html}</p>
      `;
      messages!.appendChild(div);
      messages!.scrollTop = messages!.scrollHeight;
      return div;
    }

    function addTyping() {
      const div = document.createElement('div');
      div.className = 'ask-msg ask-msg-bot ask-msg-typing';
      div.innerHTML = '<p></p>';
      messages!.appendChild(div);
      messages!.scrollTop = messages!.scrollHeight;
      return div;
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const q = input.value.trim();
      if (!q) return;

      // Ocultar sugerencias tras la primera pregunta
      if (suggestions) suggestions.style.display = 'none';

      addMessage('user', q.replace(/</g, '&lt;'));
      input.value = '';

      const typing = addTyping();

      // Intentar llamar al endpoint de IA (si hay API key configurada)
      let reply = '';
      try {
        const res = await fetch('/api/ask-book', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ question: q }),
        });

        if (res.ok) {
          const data = await res.json();
          reply = data.reply || findFallbackReply(q);
        } else {
          reply = findFallbackReply(q);
        }
      } catch {
        reply = findFallbackReply(q);
      }

      // Pequeño delay para naturalidad
      setTimeout(() => {
        typing.remove();
        addMessage('bot', reply);
      }, 700 + Math.min(reply.length * 4, 1400));
    });
  }

  document.addEventListener('astro:page-load', initAskBook);
</script>
