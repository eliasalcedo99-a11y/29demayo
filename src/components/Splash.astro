---
---

<div id="splash" class="fixed inset-0 z-[9990] flex flex-col items-center justify-center gap-5"
     style="background: #080608;">

  <!-- Vignette radial dramática -->
  <div id="splash-vignette" class="absolute inset-0 pointer-events-none" aria-hidden="true"
       style="background: radial-gradient(ellipse 60% 50% at 50% 50%, rgba(163,21,21,0.12) 0%, transparent 70%); opacity: 0;"></div>

  <!-- Flash granate sutil (impacta cuando llega la fecha) -->
  <div id="splash-flash" class="absolute inset-0 pointer-events-none mix-blend-screen" aria-hidden="true"
       style="background: radial-gradient(ellipse 30% 25% at 50% 50%, rgba(196,30,30,0.5) 0%, transparent 65%); opacity: 0;"></div>

  <!-- Línea superior que se dibuja -->
  <div id="splash-line-top"
       aria-hidden="true"
       style="height:1px; width:0; background:#A31515; will-change:width; position:relative; z-index:2;"></div>

  <!-- Título principal serif -->
  <div style="overflow:hidden; padding-bottom:0.08em;">
    <h2
      id="splash-title"
      class="select-none"
      aria-hidden="true"
      style="
        font-family: 'Playfair Display', Georgia, serif;
        font-size: clamp(3.8rem, 13vw, 9rem);
        font-weight: 700;
        letter-spacing: -0.02em;
        line-height: 1;
        color: #F2EAE0;
        transform: translateY(108%);
        will-change: transform;
      "
    >
      29 de Mayo
    </h2>
  </div>

  <!-- Fecha en mono -->
  <p
    id="splash-date"
    class="select-none"
    aria-hidden="true"
    style="
      font-family: 'DM Mono', monospace;
      font-size: clamp(0.7rem, 2vw, 0.95rem);
      letter-spacing: 0.55em;
      color: #8A7A74;
      opacity: 0;
      will-change: opacity;
    "
  >
    <span class="s-c">2</span><span
    class="s-c">9</span><span
    class="s-c" style="color:#A31515; margin:0 0.3em;">·</span><span
    class="s-c">0</span><span
    class="s-c">5</span><span
    class="s-c" style="color:#A31515; margin:0 0.3em;">·</span><span
    class="s-c">2</span><span
    class="s-c">0</span><span
    class="s-c">2</span><span
    class="s-c">3</span>
  </p>

</div>

<script>
  import gsap from 'gsap';

  function initSplash() {
    const splash  = document.getElementById('splash');
    if (!splash) return;

    const visited = sessionStorage.getItem('29mayo-splash-shown');

    if (visited) {
      splash.remove();
      // Ensure body scroll is enabled
      document.body.style.overflow = '';
    } else {
      sessionStorage.setItem('29mayo-splash-shown', '1');
      document.body.style.overflow = 'hidden';

      const tl = gsap.timeline({
        onComplete: () => {
          gsap.to(splash, {
            opacity: 0,
            duration: 0.9,
            ease: 'power2.inOut',
            delay: 0.15,
            onComplete: () => {
              splash.remove();
              document.body.style.overflow = '';
            },
          });
        },
      });

      tl
        // 1. Vignette aparece (atmósfera)
        .to('#splash-vignette', {
          opacity: 1,
          duration: 0.8,
          ease: 'power2.out',
        })
        // 2. Línea se dibuja desde el centro
        .to('#splash-line-top', {
          width: '7rem',
          duration: 0.55,
          ease: 'expo.out',
        }, '-=0.4')
        // 3. Título sube desde el clip
        .to('#splash-title', {
          y: 0,
          duration: 1.0,
          ease: 'expo.out',
        }, '-=0.15')
        // 4. Fecha aparece: contenedor + stagger de chars
        .to('#splash-date', { opacity: 1, duration: 0.01 }, '+=0.05')
        .fromTo('.s-c',
          { opacity: 0, y: 5 },
          {
            opacity: 1,
            y: 0,
            stagger: 0.065,
            duration: 0.45,
            ease: 'power3.out',
          }
        )
        // 5. Flash granate sutil al cerrar la fecha (impacto emocional)
        .to('#splash-flash', {
          opacity: 1,
          duration: 0.18,
          ease: 'power2.out',
        }, '+=0.05')
        .to('#splash-flash', {
          opacity: 0,
          duration: 0.6,
          ease: 'power2.out',
        })
        // 6. Espera dramática
        .to({}, { duration: 1.0 })
        // 7. Línea se borra antes del fade
        .to('#splash-line-top', {
          opacity: 0,
          duration: 0.4,
          ease: 'power2.in',
        }, '-=0.6');
    }
  }

  document.addEventListener('astro:page-load', initSplash);
</script>
